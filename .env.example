# Server
PORT=4000
NODE_ENV=development
APP_BASE_URL=http://localhost:4000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mobifone_sonla
DB_USER=root
DB_PASSWORD=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Admin mac dinh (dung khi chay seed)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# reCAPTCHA v3
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_MIN_SCORE=0.5

# SMTP (Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Anthropic (Chatbot AI)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Upload
UPLOAD_DIR=src/uploads
MAX_UPLOAD_SIZE_MB=5
